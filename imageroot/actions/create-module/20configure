#
# Generate the 2FAuth APP_KEY (database and session encryption key) and the
# empty secrets file. Both are private to the module user (mode 0600) and
# included in the backup. Never regenerate APP_KEY: the encrypted data
# would be lost.
#

import base64
import json
import os
import secrets
import sys

data = json.load(sys.stdin)

if not os.path.exists("key.env"):
    app_key = data.get("APP_KEY") or "base64:" + base64.b64encode(secrets.token_bytes(32)).decode()
    fd = os.open("key.env", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as fp:
        fp.write("APP_KEY=" + app_key + "\n")

if not os.path.exists("passwords.env"):
    fd = os.open("passwords.env", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    os.close(fd)
