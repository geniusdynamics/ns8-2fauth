#
# configure-module keeps the saved value of every field absent from its
# input: 06copyenv restored the TWOFAUTH_* settings, passwords.env and
# key.env come back from the backup.
#
# Let's Encrypt is never requested on restore: DNS may not point to this
# node yet. Turn it on again from the Settings page.
#

import sys
import json
import agent
import os

request = json.load(sys.stdin)
renv = request['environment']

configure_retval = agent.tasks.run(agent_id=os.environ['AGENT_ID'], action='configure-module', data={
    "lets_encrypt": False,
    "host": renv["TRAEFIK_HOST"],
    "http2https": renv.get("TRAEFIK_HTTP2HTTPS", "True").lower() == "true",
})
agent.assert_exp(configure_retval['exit_code'] == 0, "The configure-module subtask failed!")
