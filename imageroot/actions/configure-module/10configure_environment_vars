#
# Store the 2FAuth settings and generate the container env files:
# - non-secret settings go to the module environment (TWOFAUTH_*)
# - client secrets go to state/passwords.env (mode 0600)
# - state/app.env is generated for the container
#
# A field absent from the input keeps its saved value, so the Settings page
# never resets the fields that are configurable from the CLI only.
#

import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
import twofauth_conf  # noqa: E402

data = json.load(sys.stdin)
current = twofauth_conf.read_fields(os.environ)

# Non-secret settings
new_env = {}
effective = {}
for field, (_var, ftype, _default, _ui) in twofauth_conf.FIELDS.items():
    value = data[field] if field in data else current[field]
    if ftype == "str":
        value = value.strip()
    effective[field] = value
    new_env[twofauth_conf.env_name(field)] = twofauth_conf.to_env(ftype, value)
agent.mset_env(new_env)

# User preferences: the given object replaces the saved one
if "user_preferences" in data:
    for key in list(agent.read_envfile("environment")):
        if key.startswith(twofauth_conf.USERPREF_PREFIX):
            agent.unset_env(key)
    agent.mset_env(twofauth_conf.user_preferences_env(data["user_preferences"]))

# Secrets: an empty client secret keeps the saved one; clearing the client
# id removes the provider and its secret.
secrets = twofauth_conf.read_secrets()
for field, (var, owner) in twofauth_conf.SECRETS.items():
    given = data.get(field)
    if owner is not None:
        if not effective[owner]:
            secrets.pop(var, None)
        elif given:
            secrets[var] = given
    elif field in data:
        if given:
            secrets[var] = given
        else:
            secrets.pop(var, None)
twofauth_conf.write_secrets(secrets)

# Container environment
environ = agent.read_envfile("environment")
environ["TRAEFIK_HOST"] = data["host"]
twofauth_conf.write_app_env(environ)
